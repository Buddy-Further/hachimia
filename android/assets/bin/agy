#!/system/bin/sh
# 官方 Antigravity CLI (agy) 包装脚本 —— Android (bionic) 原生构建，直接执行。
# 证书与临时目录补齐安卓缺失的默认路径；应用内终端若由网关下发了 0600 密钥文件，则自动读取为 GEMINI_API_KEY。
[ -n "$PREFIX" ] && [ -r "$PREFIX/etc/tls/cert.pem" ] && export SSL_CERT_FILE="${SSL_CERT_FILE:-$PREFIX/etc/tls/cert.pem}"
[ -n "$PREFIX" ] && [ -d "$PREFIX/tmp" ] && export TMPDIR="${TMPDIR:-$PREFIX/tmp}"

case "$CCAPP_KEY_FILE" in
  ""|*[!A-Za-z0-9._/-]*) ;;
  *) [ -r "$CCAPP_KEY_FILE" ] && export GEMINI_API_KEY="$(cat "$CCAPP_KEY_FILE")" ;;
esac

AGY_BIN="${CCAPP_AGY:-$HOME/.local/share/hachimia/agy/current/agy}"
if [ ! -e "$AGY_BIN" ]; then
  echo "hachimia: Antigravity CLI (agy) 未安装，请到 设置 → 更新 中安装。" >&2
  exit 127
fi
# targetSdk ≥ 29「经加载器」模式：agy（Go）直发裸 SYS_execve 绕过 LD_PRELOAD，
# 将 SHELL 与 PATH 首段指向 APK 原生库跳板软链目录，保证 run_command 与常用工具可正常拉起。
if [ "$CCAPP_EXEC" = "loader" ] && [ -n "$CCAPP_LOADER_BIN" ] && [ -n "$CCAPP_LOADER_RUN" ] && [ -e "$CCAPP_LOADER_RUN" ]; then
  mkdir -p "$CCAPP_LOADER_BIN" 2>/dev/null
  [ -L "$CCAPP_LOADER_BIN/bash" ] || ln -sf "$CCAPP_LOADER_RUN" "$CCAPP_LOADER_BIN/bash" 2>/dev/null
  [ -L "$CCAPP_LOADER_BIN/sh" ] || ln -sf "$CCAPP_LOADER_RUN" "$CCAPP_LOADER_BIN/sh" 2>/dev/null
  export SHELL="$CCAPP_LOADER_BIN/bash"
  case ":$PATH:" in
    *":$CCAPP_LOADER_BIN:"*) ;;
    *) export PATH="$CCAPP_LOADER_BIN:$PATH" ;;
  esac
fi
exec "$AGY_BIN" "$@"
