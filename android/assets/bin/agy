#!/system/bin/sh
# 官方 Antigravity CLI (agy) 包装脚本 —— Android (bionic) 原生构建，直接执行。
# 证书与临时目录补齐安卓缺失的默认路径；应用内终端若由网关下发了 0600 密钥文件，则自动读取为 GEMINI_API_KEY。
[ -n "$PREFIX" ] && [ -r "$PREFIX/etc/tls/cert.pem" ] && export SSL_CERT_FILE="${SSL_CERT_FILE:-$PREFIX/etc/tls/cert.pem}"
[ -n "$PREFIX" ] && [ -d "$PREFIX/tmp" ] && export TMPDIR="${TMPDIR:-$PREFIX/tmp}"

case "$CCAPP_KEY_FILE" in
  ""|*[!A-Za-z0-9._/-]*) ;;
  *) [ -r "$CCAPP_KEY_FILE" ] && export GEMINI_API_KEY="$(cat "$CCAPP_KEY_FILE")" ;;
esac

AGY_BIN="${CCAPP_AGY:-$HOME/.local/share/hachimia/agy/current/agy}"
# 统一解析可用的 node 执行方式：targetSdk 36 (W^X) 下 SELinux 会让 [ -x "$PREFIX/bin/node" ] 恒为假，
# 须优先走 $CCAPP_LOADER_BIN/node，其次在 loader 且无 LD_PRELOAD 时经 /system/bin/linker64 启动 $PREFIX/bin/node。
run_node() {
  if [ "$CCAPP_EXEC" = "loader" ] && [ -n "$CCAPP_LOADER_BIN" ] && [ -e "$CCAPP_LOADER_BIN/node" ]; then
    "$CCAPP_LOADER_BIN/node" "$@"
    return $?
  fi
  if [ -n "$PREFIX" ] && [ -f "$PREFIX/bin/node" ]; then
    if [ "$CCAPP_EXEC" = "loader" ] && [ -z "$LD_PRELOAD" ] && [ -e /system/bin/linker64 ]; then
      /system/bin/linker64 "$PREFIX/bin/node" "$@"
    else
      "$PREFIX/bin/node" "$@"
    fi
    return $?
  fi
  _n=$(command -v node 2>/dev/null || true)
  if [ -n "$_n" ]; then
    "$_n" "$@"
    return $?
  fi
  return 127
}
# 终端里直接敲 `agy update` 时，转交本应用的 install-agy.mjs 走标准版本目录 + manifest.json + current 软链原子更新，
# 避免 agy 内置自更新原地覆写旧版本目录导致更新页版本脱节与 sha256 封签失效。
if [ "$1" = "update" ] && [ "$#" -eq 1 ]; then
  AGY_INSTALLER="$(dirname "$0")/../scripts/install-agy.mjs"
  if [ -f "$AGY_INSTALLER" ]; then
    run_node "$AGY_INSTALLER" stable
    exit $?
  fi
fi
if [ ! -e "$AGY_BIN" ]; then
  echo "hachimia: Antigravity CLI (agy) 未安装，请到 设置 → 更新 中安装。" >&2
  exit 127
fi
# 统一关闭 agy 后台静默原地自更新（auto_updater.go 严格比较 == "true"，填 1 无效），
# 版本升级统一归口到 设置 → 更新（或上面的 agy update -> install-agy.mjs）；
# 同时在未显式配置 D-Bus 时指向不存在的套接字，避免无桌面环境每次启动派生孤儿 dbus-daemon。
export AGY_CLI_DISABLE_AUTO_UPDATE="true"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/nonexistent}"
# targetSdk ≥ 29「经加载器」模式：agy（Go）直发裸 SYS_execve 绕过 LD_PRELOAD，
# 将 SHELL 与 PATH 首段指向 APK 原生库跳板软链目录，保证 run_command 与常用工具可正常拉起。
if [ "$CCAPP_EXEC" = "loader" ] && [ -n "$CCAPP_LOADER_BIN" ] && [ -n "$CCAPP_LOADER_RUN" ] && [ -e "$CCAPP_LOADER_RUN" ]; then
  mkdir -p "$CCAPP_LOADER_BIN" 2>/dev/null
  [ "$(readlink "$CCAPP_LOADER_BIN/bash" 2>/dev/null)" = "$CCAPP_LOADER_RUN" ] || ln -sf "$CCAPP_LOADER_RUN" "$CCAPP_LOADER_BIN/bash" 2>/dev/null
  [ "$(readlink "$CCAPP_LOADER_BIN/sh" 2>/dev/null)" = "$CCAPP_LOADER_RUN" ] || ln -sf "$CCAPP_LOADER_RUN" "$CCAPP_LOADER_BIN/sh" 2>/dev/null
  if [ -n "$PREFIX" ] && [ -f "$PREFIX/bin/node" ]; then
    [ "$(readlink "$CCAPP_LOADER_BIN/node" 2>/dev/null)" = "$CCAPP_LOADER_RUN" ] || ln -sf "$CCAPP_LOADER_RUN" "$CCAPP_LOADER_BIN/node" 2>/dev/null
  fi
  export SHELL="$CCAPP_LOADER_BIN/bash"
  case ":$PATH:" in
    *":$CCAPP_LOADER_BIN:"*) ;;
    *) export PATH="$CCAPP_LOADER_BIN:$PATH" ;;
  esac
fi
# 发行版应用内终端同样走 cc-seal.mjs 核验 agy 二进制 sha256 与官方路径（fail-closed）
SEAL_SCRIPT="$(dirname "$0")/../guard/cc-seal.mjs"
if [ -f "$SEAL_SCRIPT" ]; then
  run_node "$SEAL_SCRIPT" --verify-only "$AGY_BIN"
  _rc=$?
  if [ "$_rc" -eq 127 ]; then
    echo "hachimia: 无法启动 node 核验 Antigravity CLI 完整性，已拒绝运行。" >&2
    exit 126
  elif [ "$_rc" -ne 0 ]; then
    exit "$_rc"
  fi
fi
exec "$AGY_BIN" "$@"
